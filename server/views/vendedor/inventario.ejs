<% if (inv.aviso) { %><p role="status"><%= inv.aviso %></p><% } %>
<% if (inv.error) { %><p role="alert"><%= inv.error %></p><% } %>

<details>
  <summary>Agregar artículo</summary>
  <%- include('inventario-form', { item: null, accion: '/vendedor/inventario' }) %>
</details>

<% if (!inv.items.length && !inv.error) { %>
  <p>Aún no tienes artículos en tu inventario.</p>
<% } %>

<% inv.items.forEach((it) => { %>
  <article>
    <header>
      <strong><%= it.nombre %></strong>
      · <%= it.tipo === 'producto' ? 'Producto' : 'Servicio' %>
      · $<%= Number(it.precio).toFixed(2) %>
    </header>
    <% if (it.imagen_url) { %>
      <img src="<%= it.imagen_url %>" alt="<%= it.imagen_descripcion %>" loading="lazy" style="max-width: 100%; height: auto;">
    <% } %>
    <% if (it.descripcion) { %><p><%= it.descripcion %></p><% } %>

    <details>
      <summary>Editar</summary>
      <%- include('inventario-form', { item: it, accion: '/vendedor/inventario/' + it.id }) %>
    </details>

    <form method="post" action="/vendedor/inventario/<%= it.id %>/eliminar"
      onsubmit="return confirm('¿Eliminar este artículo?');">
      <button type="submit" class="secondary outline">Eliminar</button>
    </form>
  </article>
<% }) %>
