<section class="camara" data-camara>
  <div class="visor">
    <video data-video autoplay playsinline muted aria-label="Vista de la cámara"></video>
    <p data-estado class="visor-estado" role="status">Abriendo cámara…</p>
  </div>

  <canvas data-canvas hidden></canvas>

  <button type="button" data-tomar disabled>Tomar foto</button>

  <article data-resultado hidden aria-live="polite">
    <header><strong data-r-nombre></strong> <span data-r-tipo class="badge"></span></header>
    <p data-r-descripcion></p>
    <p><strong data-r-precio></strong></p>
    <a role="button" class="outline" data-r-agregar href="/vendedor/inventario?nuevo=1">Agregar al inventario</a>
  </article>

  <p data-error role="alert" hidden></p>
</section>
<script src="/public/js/camara.js" defer></script>
