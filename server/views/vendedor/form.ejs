<%- include('../partials/head') %>

<nav aria-label="breadcrumb">
  <ul><li><a href="/vendedor">Vendedores</a></li><li>Nuevo</li></ul>
</nav>

<h1>Nuevo vendedor</h1>

<form method="post" action="/vendedor" novalidate>
  <label>
    Nombre completo
    <input name="nombre" value="<%= values.nombre || '' %>" required
      <%- errors.nombre ? 'aria-invalid="true"' : '' %>>
    <% if (errors.nombre) { %><small><%= errors.nombre %></small><% } %>
  </label>

  <label>
    Correo electrónico
    <input type="email" name="email" value="<%= values.email || '' %>" required
      <%- errors.email ? 'aria-invalid="true"' : '' %>>
    <% if (errors.email) { %><small><%= errors.email %></small><% } %>
  </label>

  <div class="grid">
    <label>
      Zona
      <select name="zona" <%- errors.zona ? 'aria-invalid="true"' : '' %>>
        <option value="">Selecciona…</option>
        <% ['Norte', 'Centro', 'Sur'].forEach((z) => { %>
          <option <%= values.zona === z ? 'selected' : '' %>><%= z %></option>
        <% }) %>
      </select>
      <% if (errors.zona) { %><small><%= errors.zona %></small><% } %>
    </label>
    <label>
      Ventas iniciales
      <input type="number" name="ventas" min="0" step="0.01" value="<%= values.ventas || 0 %>"
        <%- errors.ventas ? 'aria-invalid="true"' : '' %>>
      <% if (errors.ventas) { %><small><%= errors.ventas %></small><% } %>
    </label>
  </div>

  <div class="grid">
    <a href="/vendedor" role="button" class="secondary outline">Cancelar</a>
    <button type="submit">Guardar</button>
  </div>
</form>

<%- include('../partials/footer') %>
