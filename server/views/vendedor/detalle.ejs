<%- include('../partials/head') %>

<nav aria-label="breadcrumb">
  <ul><li><a href="/vendedor">Vendedores</a></li><li><%= vendedor.nombre %></li></ul>
</nav>

<article>
  <header><h1><%= vendedor.nombre %></h1></header>
  <dl>
    <dt>Correo</dt><dd><a href="mailto:<%= vendedor.email %>"><%= vendedor.email %></a></dd>
    <dt>Zona</dt><dd><%= vendedor.zona %></dd>
    <dt>Ventas acumuladas</dt><dd><strong><%= money(vendedor.ventas) %></strong></dd>
  </dl>
  <footer><a href="/vendedor" role="button" class="secondary outline">← Volver</a></footer>
</article>

<%- include('../partials/footer') %>
