<%- include('partials/head') %>

<div class="page">
  <hgroup>
    <h1>Bienvenido a <%= siteName %></h1>
    <p>Elige una sección</p>
  </hgroup>

  <% for (const s of Object.values(secciones)) { %>
    <article>
      <header><a href="<%= s.base %>"><strong><%= s.titulo %></strong></a></header>
      <ul>
        <% s.paginas.forEach((p) => { %>
          <li><a href="<%= s.base %>/<%= p.slug %>"><%= p.titulo %></a></li>
        <% }) %>
      </ul>
    </article>
  <% } %>
</div>

<%- include('partials/footer') %>
