{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snapCart",
  "version": "0.1.0",
  "identifier": "com.snapcart.app",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "npm run dev:api",
    "beforeBuildCommand": "node scripts/vendor.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "snapCart",
        "width": 420,
        "height": 820,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
